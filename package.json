{
  "name": "@webship.co/workspace-wordpress",
  "version": "1.0.10",
  "description": "WordPress for Webship Workspace: the builder (`cmd-wordpress-project.sh`) and the WP-CLI tool in every sites folder, the default accounts, the WordPress step pack wired into the testing setup, and its AI items in their folders: two agents, a skill, a command and two prompts. The reference platform plugin.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-wordpress.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "docs",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "wordpress",
    "label": "WordPress",
    "needs": [
      [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-wordpress-project.sh",
        "commands/cmd-tools-wordpress-cli.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-wordpress.sh"
      ],
      "args": [
        "scripts/args/arg-wordpress.sh",
        "scripts/args/arg-wordpress-cli.sh"
      ],
      "machine": [
        "testing/site.feature"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/wordpress-site-builder.md",
        "ai/agents/wordpress-tester.md"
      ],
      "skills": [
        "ai/skills/wordpress-scenarios"
      ],
      "commands": [
        "ai/commands/wordpress-test.md"
      ],
      "prompts": [
        "ai/prompts/wordpress-build-and-test.md",
        "ai/prompts/wordpress-scenarios-for-a-role.md"
      ]
    },
    "features": [
      "features/wordpress.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.7",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
